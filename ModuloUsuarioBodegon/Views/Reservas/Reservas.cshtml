@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <title>Reservá tu lugar - Bodegón Don Macanudo</title>
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.2.0/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/font-awesome/4.4.0/css/font-awesome.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Roboto:wght@400;700&display=swap" rel="stylesheet">
    <link href="~/css/style.css" rel="stylesheet">
    <script src="~/js/validaciones.js" asp-append-version="true"></script>
</head>
<body>
    <div id="cabecera">
        <div class="circulo-logo">
            <img src="~/imagenes/logo_chef_bodegon.png" alt="Logo Bodegón Don Macanudo" class="img-logo">
        </div>
        <h1>BODEGÓN DON MACANUDO</h1>
        <p class="subtitulo">— Cocina Mítica • Recetas Fantásticas & Minutas Gigantes —</p>
    </div>

    <div class="container contenedor-principal">

        <div class="caja-reserva">
            <h2><i class="fa fa-calendar"></i> Reservá tu lugar</h2>
            <p class="reserva-subtitulo">Completá tus datos y recibí tu número de reserva</p>

            <form asp-action="Create" method="POST" id="form-reserva">

                <!-- Campo Fecha -->
                <div class="form-group" id="grupo-fecha">
                    <label for="r-fecha">Fecha</label>
                    <input type="date" id="r-fecha" name="Fecha" value="@ViewBag.Fecha" class="form-control" required>
                    <span class="help-block hidden" id="error-fecha">Los Lunes no abre el bodegón.</span>
                </div>

                <!-- Campo Nombre -->
                <div class="form-group" id="grupo-nombre">
                    <label for="r-nombre">Nombre</label>
                    <input type="text" id="r-nombre" name="Nombre" value="@ViewBag.Nombre" class="form-control" required>
                    <span class="help-block hidden" id="error-nombre">El Nombre no es válido.</span>
                </div>

                <!-- Campo Teléfono -->
                <div class="form-group" id="grupo-telefono">
                    <label for="r-telefono">Teléfono</label>
                    <input type="text" id="r-telefono" name="Telefono" value="@ViewBag.Telefono" class="form-control" placeholder="11XXXXXXXX" required>
                    <span class="help-block hidden" id="error-telefono">Teléfono no válido.</span>
                </div>

                <!-- Campo Email -->
                <div class="form-group" id="grupo-email">
                    <label for="r-email">Correo Electrónico</label>
                    <input type="email" id="r-email" name="Email" value="@ViewBag.Email" class="form-control" placeholder="correo@ejemplo.com" required>
                    <span class="help-block hidden" id="error-email">Correo electrónico no válido.</span>
                </div>

                <!-- Turno -->
                <div class="form-group">
                    <label for="r-turno">Turno</label>
                    <select id="r-turno" name="Turno" class="form-control" required>
                        <option value="">Elegí un turno</option>
                        <option value="Almuerzo" selected="@(ViewBag.Turno == "Almuerzo" ? "selected" : null)">Almuerzo</option>
                        <option value="Merienda" selected="@(ViewBag.Turno == "Merienda" ? "selected" : null)">Merienda</option>
                        <option value="Cena" selected="@(ViewBag.Turno == "Cena" ? "selected" : null)">Cena</option>
                    </select>
                </div>

                <!-- Cantidad de personas -->
                <div class="form-group" id="grupo-cantidad">
                    <label for="r-personas">Cantidad de personas</label>
                    <input type="number" id="r-personas" name="CantidadPersonas" value="@ViewBag.CantidadPersonas" class="form-control" min="1" required>
                    <span class="help-block hidden" id="error-cantidad">La cantidad debe ser al menos 1.</span>
                </div>

                <!-- RESUMEN DE ERRORES: Solo aparece si hay un error y se ubica arriba del botón -->
                @if (!ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="All" class="alert alert-danger" style="margin-bottom: 20px;"></div>
                }

                <button type="submit" class="btn btn-lg btn-block btn-reserva"><i class="fa fa-check"></i> Grabar reserva</button>
            </form>

            <a asp-controller="Home" asp-action="Index" class="enlace-volver">&larr; Volver al menú principal</a>
        </div>

    </div>

    <div id="footer">
        <p><strong>Bodegón Don Macanudo</strong> — Pasaje Ficticio 1234 (Esquina Fantasía)</p>
        <p>Reservas: (011) 5555-4321 — Abierto de Martes a Domingos</p>
        <ul class="list-inline">
            <li><a href="https://instagram.com" target="_blank"><i class="fa fa-instagram"></i></a></li>
            <li><a href="https://facebook.com" target="_blank"><i class="fa fa-facebook"></i></a></li>
            <li><a href="https://whatsapp.com" target="_blank"><i class="fa fa-whatsapp"></i></a></li>
        </ul>
    </div>
</body>
</html>